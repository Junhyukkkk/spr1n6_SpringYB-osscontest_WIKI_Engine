# /etc/team-wiki/secrets.env — 소유자 root:root, 권한 0600. 이 저장소에 실제 값을 넣지 않는다.
# systemd가 root로 읽어 서비스 환경변수로만 넘긴다. 서비스 사용자(teamwiki)는 이 파일을 직접 읽을 수 없다.
# 값에 따옴표·공백을 넣지 않는다. 토큰을 URL·team.json·명령줄에 쓰지 않는다. 프록시 변수는 두지 않는다.
ANTHROPIC_API_KEY=
DISCORD_TOKEN=
# delivery: github일 때 데이터 저장소 push·PR에 필수. local일 때는 공개 저장소 읽기 API 한도용(선택).
GITHUB_TOKEN=
