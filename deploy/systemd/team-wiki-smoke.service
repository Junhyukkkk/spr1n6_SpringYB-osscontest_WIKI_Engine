# 실제 SDK 보안 스모크(비용 발생). 서비스와 같은 샌드박스에서 사람이 손으로만 돌린다:
#   sudo systemctl start team-wiki-smoke.service && journalctl -u team-wiki-smoke.service -o cat --no-pager
# [Install]·타이머·OnFailure가 없다 — 자동으로 돌지 않는다.
[Unit]
Description=team-wiki 실제 SDK 보안 스모크 (수동 실행 전용, 비용 발생)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=teamwiki
Group=teamwiki
WorkingDirectory=/opt/team-wiki-engine
Environment=HOME=/srv/team-wiki/home
Environment=TEAM_WIKI_HOME=/srv/team-wiki
Environment=TEAM_WIKI_CONFIG=/etc/team-wiki/team.json
Environment=TEAM_WIKI_ENGINE_DIR=/opt/team-wiki-engine
Environment=LANG=C.UTF-8
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
Environment=LIVE_CLAUDE=1
EnvironmentFile=/etc/team-wiki/secrets.env
ExecStartPre=/opt/team-wiki-engine/.venv/bin/team-wiki-preflight --role smoke
ExecStart=/opt/team-wiki-engine/.venv/bin/python -m pytest -m live -q -rP -p no:cacheprovider /opt/team-wiki-engine/tests/claude/test_live_smoke.py
TimeoutStartSec=2h
TimeoutStopSec=2min
KillMode=control-group
KillSignal=SIGTERM
MemoryMax=3G
TasksMax=256
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/team-wiki
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
