# team-wiki 동기화(코드 반영 · 문서 반영). 타이머가 하루 두 번 부른다.
# 종료 코드 1(단계 실패·실행 오류·수동 정지)은 프로그램이 이미 운영 채널에 알렸으므로 성공으로 친다.
# 시간 상한은 코드의 상수에서 계산했다(tests/deploy/test_units.py).
[Unit]
Description=team-wiki 동기화 (코드 반영 · 문서 반영)
Wants=network-online.target
After=network-online.target
OnFailure=team-wiki-notify@%n.service

[Service]
Type=oneshot
User=teamwiki
Group=teamwiki
WorkingDirectory=/srv/team-wiki
Environment=HOME=/srv/team-wiki/home
Environment=TEAM_WIKI_HOME=/srv/team-wiki
Environment=TEAM_WIKI_CONFIG=/etc/team-wiki/team.json
Environment=TEAM_WIKI_ENGINE_DIR=/opt/team-wiki-engine
Environment=LANG=C.UTF-8
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
EnvironmentFile=/etc/team-wiki/secrets.env
ExecStartPre=/opt/team-wiki-engine/.venv/bin/team-wiki-preflight --role sync --quiet
ExecStart=/opt/team-wiki-engine/.venv/bin/team-wiki-sync
SuccessExitStatus=1
TimeoutStartSec=11h
TimeoutStopSec=15min
KillMode=control-group
KillSignal=SIGTERM
MemoryMax=3G
TasksMax=256
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/team-wiki
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
